{
  "title": "Suryamon: Plant Overview",
  "uid": "suryamon-plant",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "AC Power Now",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [{ "expr": "sum(suryamon_ac_power_watts)" }]
    },
    {
      "type": "stat", "title": "Performance Ratio (1d)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 0.7 },
        { "color": "green", "value": 0.78 }
      ] } } },
      "targets": [{ "expr": "suryamon_performance_ratio{window=\"1d\"}" }]
    },
    {
      "type": "stat", "title": "Specific Yield (1d)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 } },
      "targets": [{ "expr": "suryamon_specific_yield_kwh_kwp{window=\"1d\"}" }]
    },
    {
      "type": "stat", "title": "Inverters Online",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "sum(suryamon_inverter_up)" }]
    },
    {
      "type": "timeseries", "title": "AC Power by Inverter",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [{ "expr": "suryamon_ac_power_watts", "legendFormat": "{{inverter}}" }]
    },
    {
      "type": "timeseries", "title": "String Currents (all inverters)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "amp" } },
      "targets": [{ "expr": "suryamon_string_current_amps", "legendFormat": "{{inverter}}/s{{string}}" }]
    },
    {
      "type": "heatmap", "title": "String Anomaly Scores",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [{ "expr": "suryamon_string_anomaly_score", "legendFormat": "{{inverter}}/s{{string}}" }]
    },
    {
      "type": "timeseries", "title": "Cabinet Temperature",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "celsius" } },
      "targets": [{ "expr": "suryamon_cabinet_temp_celsius", "legendFormat": "{{inverter}}" }]
    }
  ],
  "schemaVersion": 39
}
